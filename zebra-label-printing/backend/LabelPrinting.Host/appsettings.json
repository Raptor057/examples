{
  "ConnectionStrings": {
    "LabelPrintingDb": "Data Source=label-printing.db"
  },
  "Printing": {
    "Driver": "simulator",
    "SimulatorOutputPath": "printed-labels",
    "NetworkTimeoutMs": 3000,
    "DiscoveryTimeoutSeconds": 5,
    "Preflight": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Preview": {
    "Enabled": false,
    "BaseUrl": "http://api.labelary.com",
    "LabelSize": "4x6",
    "TimeoutSeconds": 10
  },
  "PrintQueue": {
    "Enabled": true,
    "PollSeconds": 5
  },
  "Access": {
    "EnforcePermissions": true
  },
  "Jwt": {
    "SigningKey": "cambia-esta-llave-en-cualquier-despliegue-real-min-32-bytes",
    "Issuer": "zebra-label-printing",
    "Audience": "zebra-label-printing-clients"
  }
}
